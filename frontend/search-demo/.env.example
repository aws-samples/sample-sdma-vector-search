# Cognito (from SDMA deployment)
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxx
VITE_AWS_REGION=ap-northeast-1

# Extension API endpoint (this extension's API Gateway)
